# Required: OpenRouter API key for the LLM judge
OPENROUTER_API_KEY=

# Optional: model to use via OpenRouter (default: anthropic/claude-3.5-sonnet)
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Optional: cap max tokens per request (useful for low-credit keys)
# OPENROUTER_MAX_TOKENS=2000

# Optional: VirusTotal API key for threat reputation
# Without this key the VirusTotal collector returns data_unavailable.
VIRUSTOTAL_API_KEY=
