# Required: OpenRouter API key for the LLM judge
OPENROUTER_API_KEY=

# Optional: model to use via OpenRouter (default: anthropic/claude-3.5-sonnet)
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Optional: cap max tokens per request (useful for low-credit keys)
# OPENROUTER_MAX_TOKENS=2000

# Optional: VirusTotal API key for threat reputation
# Without this key the VirusTotal collector returns data_unavailable.
VIRUSTOTAL_API_KEY=

# Optional: Tavily API key for the threat-history research agent
# Without this key the threat_history collector returns data_unavailable.
TAVILY_API_KEY=

# Optional: override the model used by the threat-history agent (defaults to OPENROUTER_MODEL)
# THREAT_HISTORY_MODEL=anthropic/claude-3.5-sonnet

# Optional: tune the threat-history agent search budget
# THREAT_HISTORY_MAX_SEARCHES=8
# THREAT_HISTORY_MAX_RESULTS_PER_SEARCH=5
# THREAT_HISTORY_SEARCH_DEPTH=basic   # "basic" (default) or "advanced"
